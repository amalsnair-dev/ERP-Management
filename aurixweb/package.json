{
  "name": "frontend-main",
  "private": true,
  "version": "1.0.70",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "test": "vitest",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/increment-version.js && powershell -NoProfile -Command \"if (Test-Path 'aurixapp\\\\assets') { Remove-Item -LiteralPath 'aurixapp\\\\assets' -Recurse -Force }; if (Test-Path 'aurixapp\\\\index.html') { Remove-Item -LiteralPath 'aurixapp\\\\index.html' -Force }; if (Test-Path 'aurixapp.war') { Remove-Item -LiteralPath 'aurixapp.war' -Force }\"",
    "build:web": "vite build",
    "build:war": "cd aurixapp && bestzip ..\\aurixapp.war *",
    "build": "npm run build:web && npm run build:war",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/react-fontawesome": "^3.0.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.12.2",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.1",
    "tailwindcss": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "bestzip": "^2.2.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.2",
    "vitest": "^4.1.9"
  }
}
