					]
				}
			}
		},
		{
			"name": "🔨 9. Create Table Manually",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "username", "value": "{{username}}" },
					{ "key": "password", "value": "{{password}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/giftmaster/create-table?shopcode={{shopcode}}",
					"host": ["{{baseUrl}}"],
