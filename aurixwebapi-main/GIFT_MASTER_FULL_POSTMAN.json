					"raw": "{{baseUrl}}/giftmaster/update?shopcode={{shopcode}}",
					"host": ["{{baseUrl}}"],
					"path": ["giftmaster", "update"],
					"query": [
						{ "key": "shopcode", "value": "{{shopcode}}" }
					]
				}
			}
		},
		{
			"name": "🗑️ 7. Delete Gift",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "username", "value": "{{username}}" },
					{ "key": "password", "value": "{{password}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/giftmaster/delete?giftId=1&shopcode={{shopcode}}",
