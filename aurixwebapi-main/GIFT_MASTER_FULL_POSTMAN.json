{
	"info": {
		"_postman_id": "gift-master-full-package-v1",
		"name": "🎁 Gift Master API - Full Package",
		"description": "Complete REST API Collection for Gift Master module in Aurix Web API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "⚡ 1. Fast Table Lookup (giftCode & giftName only)",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "username", "value": "{{username}}" },
					{ "key": "password", "value": "{{password}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/giftmaster/lookup?shopcode={{shopcode}}",
					"host": ["{{baseUrl}}"],
					"path": ["giftmaster", "lookup"],
					"query": [
						{ "key": "shopcode", "value": "{{shopcode}}" }
					]
				}
			}
		},
		{
			"name": "➕ 2. Save Gift (Add New)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "username", "value": "{{username}}" },
					{ "key": "password", "value": "{{password}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"giftId\": null,\n  \"giftCode\": \"GIFT001\",\n  \"giftName\": \"Gold Coin 1g\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/giftmaster/save?shopcode={{shopcode}}",
					"host": ["{{baseUrl}}"],
					"path": ["giftmaster", "save"],
					"query": [
						{ "key": "shopcode", "value": "{{shopcode}}" }
					]
				}
			}
		},
		{
			"name": "📋 3. Get All Gifts",
			"request": {
