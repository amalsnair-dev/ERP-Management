						{ "key": "giftCode", "value": "GIFT001" },
						{ "key": "shopcode", "value": "{{shopcode}}" }
					]
				}
			}
		},
		{
			"name": "🔍 5. Get Gift By ID",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "username", "value": "{{username}}" },
					{ "key": "password", "value": "{{password}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/giftmaster/getById?giftId=1&shopcode={{shopcode}}",
					"host": ["{{baseUrl}}"],
					"path": ["giftmaster", "getById"],
					"query": [
						{ "key": "giftId", "value": "1" },
						{ "key": "shopcode", "value": "{{shopcode}}" }
					]
				}
			}
		},
