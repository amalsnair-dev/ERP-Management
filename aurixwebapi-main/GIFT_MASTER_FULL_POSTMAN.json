					"query": [
						{ "key": "shopcode", "value": "{{shopcode}}" }
					]
				}
			}
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
		{ "key": "username", "value": "BLOGTEC", "type": "string" },
		{ "key": "password", "value": "1234", "type": "string" },
		{ "key": "shopcode", "value": "TCR", "type": "string" }
