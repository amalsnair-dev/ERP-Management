				"header": [
					{ "key": "username", "value": "{{username}}" },
					{ "key": "password", "value": "{{password}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/giftmaster/all?shopcode={{shopcode}}",
					"host": ["{{baseUrl}}"],
					"path": ["giftmaster", "all"],
					"query": [
						{ "key": "shopcode", "value": "{{shopcode}}" }
					]
				}
			}
		},
		{
			"name": "🔍 4. Get Gift By Code",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "username", "value": "{{username}}" },
					{ "key": "password", "value": "{{password}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/giftmaster/getByCode?giftCode=GIFT001&shopcode={{shopcode}}",
					"host": ["{{baseUrl}}"],
