					]
				}
			}
		},
		{
			"name": "✅ 8. Check Exists By Code",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "username", "value": "{{username}}" },
					{ "key": "password", "value": "{{password}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/giftmaster/existsByCode?giftCode=GIFT001&shopcode={{shopcode}}",
					"host": ["{{baseUrl}}"],
					"path": ["giftmaster", "existsByCode"],
					"query": [
						{ "key": "giftCode", "value": "GIFT001" },
